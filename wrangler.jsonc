
{
  "name": "lala-cases-store",
  "main": "src/index.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lala-cases-db",
      "database_id": "51f00c4d-84b5-4b54-981f-a93c8207ad4f"
    }
  ]
}
